# Leave DATABASE_URL blank to use the local PostgreSQL settings.
DATABASE_URL=
POSTGRES_PASSWORD=
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# Background delivery
ALERT_CHECK_SECONDS=900
# Exact, verified account email addresses permitted to use Administration
ADMIN_EMAILS=
# Public origin serving the frontend and /api proxy
PUBLIC_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local semantic website help; false keeps reviewed keyword search only.
CHATBOT_SEMANTIC_ENABLED=true

# Use cached local language model for approximate interview topic overlap
INTERVIEW_SEMANTIC_ENABLED=true
